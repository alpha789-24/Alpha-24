# Alpha24 Strategy Studio — Environment Configuration (Placeholders Only)
# Copy this file to backend/.env and fill in your values. Never commit real secrets.

APP_NAME="Alpha24 Strategy Studio"

# Persistence backend: "json" (default local files in backend/data/) or "mongo"
STORE_BACKEND=json
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=alpha_strategy_studio

# FC/RC Level Provider Safety Flag
# Keep false for real trading. Only set true for wiring tests with dummy placeholder sheets.
LEVELS_PLACEHOLDER_ENABLED=false

# Background Workers
SAR_WORKER_ENABLED=true

# IIFL Broker Credentials (Read from backend env only; never exposed to frontend or strategy exports)
IIFL_API_BASE_URL=https://api.iiflcapital.com/v1
IIFL_APP_KEY=your_iifl_app_key_here
IIFL_APP_SECRET=your_iifl_app_secret_here
IIFL_REDIRECT_URL=http://127.0.0.1:8000/api/iifl/callback
